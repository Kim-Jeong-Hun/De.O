{
  "name": "de-o",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:api": "pnpm --filter api dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:crawler": "uv run --project apps/crawler python apps/crawler/src/main.py",
    "db:generate": "pnpm --filter @de-o/db generate",
    "db:validate": "pnpm --filter @de-o/db validate"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
